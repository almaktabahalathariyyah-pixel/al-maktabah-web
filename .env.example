# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง
#   cp .env.example .env.local
#
# หรือถ้าตั้งค่าไว้ใน Vercel แล้ว ดึงลงมาทีเดียวได้เลย:
#   npx vercel link      (ครั้งแรกครั้งเดียว)
#   npx vercel env pull .env.local
#
# .env.local อยู่ใน .gitignore แล้ว ห้าม commit เด็ดขาด


# ─────────────────────────────────────────────────────────────
# Firebase — ที่เก็บข้อมูลหนังสือและระบบล็อกอิน
# หาได้จาก: console.firebase.google.com
#   → เลือกโปรเจกต์ → ⚙️ Project settings → ทั่วไป
#   → เลื่อนลงหา "Your apps" → เลือกเว็บแอป → "SDK setup and configuration"
#
# ค่าเหล่านี้ขึ้นต้นด้วย NEXT_PUBLIC_ แปลว่าถูกฝังลงในหน้าเว็บและ
# ใครก็เปิดดูได้ — ไม่ใช่ความลับ และไม่ใช่ช่องโหว่
# สิ่งที่กันข้อมูลจริงๆ คือ firestore.rules ไม่ใช่การซ่อนคีย์พวกนี้
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ไม่บังคับ — ใส่เมื่อเปิดใช้ Google Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# ─────────────────────────────────────────────────────────────
# Google Drive — ที่เก็บไฟล์ PDF
# หาได้จาก: console.cloud.google.com
#   → APIs & Services → Credentials
#   → Create credentials → OAuth client ID → Web application
#
# ต้องตั้งค่าเพิ่ม 2 อย่าง ไม่งั้นการอัปโหลดจะไม่ทำงาน:
#   1. Authorized JavaScript origins ใส่โดเมนเว็บ
#      เช่น https://your-site.vercel.app และ http://localhost:3000
#   2. เปิดใช้ Google Drive API ที่ APIs & Services → Library
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# ─────────────────────────────────────────────────────────────
# Telegram — ใช้เก็บรูปหน้าปก และสำเนาสำรองของไฟล์ที่ไม่เกิน 20MB
#
# ⚠️ ห้ามใส่ NEXT_PUBLIC_ นำหน้าสองตัวนี้เด็ดขาด
#    bot token คือสิทธิ์ควบคุมบอททั้งหมด ถ้าหลุดไปหน้าเว็บ
#    ใครก็เอาไปใช้ได้ (เดิมระบบเคยหลุดจริง แก้ไปแล้ว)
#
# BOT_TOKEN  : ทักหา @BotFather ใน Telegram → /newbot
# CHAT_ID    : สร้างแชนแนล เพิ่มบอทเป็นแอดมิน แล้วส่งข้อความสักอัน
#              จากนั้นเปิด https://api.telegram.org/bot<TOKEN>/getUpdates
#              ดูค่า chat.id (ของแชนแนลจะขึ้นต้นด้วย -100)
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ─────────────────────────────────────────────────────────────
# ไม่บังคับ
# ─────────────────────────────────────────────────────────────

# ลิงก์แชนแนล Telegram ที่แสดงตรงท้ายเว็บ
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=

# ลิงก์ LINE OA สำรอง สำหรับหน้าที่บอกผู้อ่านตอนหนังสือเปิดไม่ได้
# ปกติตั้งในเว็บได้เลยที่ แผงควบคุม → ตั้งค่าหมวดหมู่ → ช่องทางติดต่อ
# ค่านี้ใช้เมื่อยังไม่ได้ตั้งในเว็บ
NEXT_PUBLIC_LINE_OA_URL=
